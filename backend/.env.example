# Application Settings
APP_NAME="AI-Assisted Legal Case Guidance and Prediction System"
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Sentence Transformers (Retrieval / Embeddings)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Data & Model Artifact Paths (relative to backend/ or absolute)
RANDOM_FOREST_MODEL_DIR=data/models/random_forest_exp3
RETRIEVAL_DATA_DIR=data/retrieval/Case_Files
RETRIEVAL_INDEX_DIR=data/retrieval_index
RETRIEVAL_TOP_K=5
